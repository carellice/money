<?xml version="1.0" encoding="utf-8"?>
<!--
    Server CasaOS: the app may talk to the user's own Money server, which can use the local CA
    installed on the phone (local HTTPS mode) or plain HTTP on the home network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
